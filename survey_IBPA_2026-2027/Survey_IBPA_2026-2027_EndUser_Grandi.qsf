"4":{"Display":"Budgeting, forecast e analisi degli scostamenti rispetto al consuntivo"},"5":{"Display":"Gestione degli incassi, solleciti e riconciliazioni bancarie"},"6":{"Display":"Adempimenti fiscali e conservazione digitale a norma"}},"ChoiceOrder":["1","2","3","4","5","6"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"NextChoiceId":7,"NextAnswerId":5,"Answers":{"1":{"Display":"Automatizzato – automazione tradizionale"},"2":{"Display":"Automatizzato – automazione intelligente o agentic"},"3":{"Display":"Non automatizzato, prioritario nei prossimi 12 mesi"},"4":{"Display":"Non automatizzato / non rilevante"}},"AnswerOrder":["1","2","3","4"],"ChoiceDataExportTags":false,"GradingData":[],"Language":[],"QuestionID":"QID21","DisplayLogic":{"0":{"0":{"LogicType":"Question","QuestionID":"QID11","QuestionIsInLoop":"no","ChoiceLocator":"q://QID11/SelectableChoice/1","Operator":"Selected","QuestionIDFromLocator":"QID11","LeftOperand":"q://QID11/SelectableChoice/1","Type":"Expression","Description":"<span class=\"ConjDesc\">Se</span> <span class=\"QuestionDesc\">Quale affermazione rispecchia meglio l’attuale approccio alla Process Automation nella sua azie...</span> <span class=\"LeftOpDesc\">L’automazione è applicata a specifici dipartimenti o processi, senza una strategia aziendale centralizzata (es. automazione limitata a HR o gestione ordini).</span> <span class=\"OpDesc\">è selezionato</span> "},"1":{"LogicType":"Question","QuestionID":"QID11","QuestionIsInLoop":"no","ChoiceLocator":"q://QID11/SelectableChoice/2","Operator":"Selected","QuestionIDFromLocator":"QID11","LeftOperand":"q://QID11/SelectableChoice/2","Type":"Expression","Description":"<span class=\"ConjDesc\">O</span> <span class=\"QuestionDesc\">Quale affermazione rispecchia meglio l’attuale approccio alla Process Automation nella sua azie...</span> <span class=\"LeftOpDesc\">L’automazione è adottata in diversi dipartimenti o processi, ma non è ancora trasversale o parte di una strategia aziendale complessiva (es. automazione in finanza e HR, ma non in supply chain o customer service).</span> <span class=\"OpDesc\">è selezionato</span> ","Conjuction":"Or"},"2":{"LogicType":"Question","QuestionID":"QID11","QuestionIsInLoop":"no","ChoiceLocator":"q://QID11/SelectableChoice/3","Operator":"Selected","QuestionIDFromLocator":"QID11","LeftOperand":"q://QID11/SelectableChoice/3","Type":"Expression","Description":"<span class=\"ConjDesc\">O</span> <span class=\"QuestionDesc\">Quale affermazione rispecchia meglio l’attuale approccio alla Process Automation nella sua azie...</span> <span class=\"LeftOpDesc\">L’automazione è integrata trasversalmente nella strategia aziendale, coinvolgendo più dipartimenti e processi.</span> <span class=\"OpDesc\">è selezionato</span> ","Conjuction":"Or"},"3":{"LogicType":"Question","QuestionID":"QID11","QuestionIsInLoop":"no","ChoiceLocator":"q://QID11/SelectableChoice/5","Operator":"Selected","QuestionIDFromLocator":"QID11","LeftOperand":"q://QID11/SelectableChoice/5","Type":"Expression","Description":"<span class=\"ConjDesc\">O</span> <span class=\"QuestionDesc\">Quale affermazione rispecchia meglio l’attuale approccio alla Process Automation nella sua azie...</span> <span class=\"LeftOpDesc\">Altro (specificare il tipo di approccio adottato):</span> <span class=\"OpDesc\">è selezionato</span> ","Conjuction":"Or"},"4":{"LogicType":"Question","QuestionID":"QID17","QuestionIsInLoop":"no","ChoiceLocator":"q://QID17/SelectableChoice/1","Operator":"Selected","QuestionIDFromLocator":"QID17","LeftOperand":"q://QID17/SelectableChoice/1","Type":"Expression","Description":"<span class=\"ConjDesc\">O</span> <span class=\"QuestionDesc\">Quali di questi strumenti sono presenti nella sua realtà? Risposta multipla – selezionare tutte...</span> <span class=\"LeftOpDesc\">Soluzioni di Robotic Process Automation – esempi: UiPath, Blue Prism, Automation Anywhere</span> <span class=\"OpDesc\">è selezionato</span> ","Co