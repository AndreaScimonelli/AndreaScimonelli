pan></em><br />\n<br />\n<strong>Customer service e gestione della relazione con il cliente</strong>","DefaultChoices":false,"DataExportTag":"Q5.3d","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Per le famiglie selezionate, indichi lo stato di automazione dei singoli processi. Una risposta...","Choices":{"1":{"Display":"Gestione delle anagrafiche cliente, single customer view e qualità del dato CRM"},"2":{"Display":"Ricezione e smistamento delle richieste (ticketing, classificazione, routing)"},"3":{"Display":"Risoluzione delle richieste e gestione delle escalation"},"4":{"Display":"Gestione dei reclami e analisi delle cause"},"5":{"Display":"Servizi post-vendita e pianificazione degli interventi tecnici"},"6":{"Display":"Raccolta dei feedback e misurazione della soddisfazione (NPS, CSAT, CES)"},"7":{"Display":"Programmi di loyalty, retention e personalizzazione"}},"ChoiceOrder":["1","2","3","4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"NextChoiceId":8,"NextAnswerId":5,"Answers":{"1":{"Display":"Automatizzato – automazione tradizionale"},"2":{"Display":"Automatizzato – automazione intelligente o agentic"},"3":{"Display":"Non automatizzato, prioritario nei prossimi 12 mesi"},"4":{"Display":"Non automatizzato / non rilevante"}},"AnswerOrder":["1","2","3","4"],"ChoiceDataExportTags":false,"GradingData":[],"Language":[],"QuestionID":"QID24","DisplayLogic":{"0":{"0":{"LogicType":"Question","QuestionID":"QID11","QuestionIsInLoop":"no","ChoiceLocator":"q://QID11/SelectableChoice/1","Operator":"Selected","QuestionIDFromLocator":"QID11","LeftOperand":"q://QID11/SelectableChoice/1","Type":"Expression","Description":"<span class=\"ConjDesc\">Se</span> <span class=\"QuestionDesc\">Quale affermazione rispecchia meglio l’attuale approccio alla Process Automation nella sua azie...</span> <span class=\"LeftOpDesc\">L’automazione è applicata a specifici dipartimenti o processi, senza una strategia aziendale centralizzata (es. automazione limitata a HR o gestione ordini).</span> <span class=\"OpDesc\">è selezionato</span> "},"1":{"LogicType":"Question","QuestionID":"QID11","QuestionIsInLoop":"no","ChoiceLocator":"q://QID11/SelectableChoice/2","Operator":"Selected","QuestionIDFromLocator":"QID11","LeftOperand":"q://QID11/SelectableChoice/2","Type":"Expression","Description":"<span class=\"ConjDesc\">O</span> <span class=\"QuestionDesc\">Quale affermazione rispecchia meglio l’attuale approccio alla Process Automation nella sua azie...</span> <span class=\"LeftOpDesc\">L’automazione è adottata in diversi dipartimenti o processi, ma non è ancora trasversale o parte di una strategia aziendale complessiva (es. automazione in finanza e HR, ma non in supply chain o customer service).</span> <span class=\"OpDesc\">è selezionato</span> ","Conjuction":"Or"},"2":{"LogicType":"Question","QuestionID":"QID11","QuestionIsInLoop":"no","ChoiceLocator":"q://QID11/SelectableChoice/3","Operator":"Selected","QuestionIDFromLocator":"QID11","LeftOperand":"q://QID11/SelectableChoice/3","Type":"Expression","Description":"<span class=\"ConjDesc\">O</span> <span class=\"QuestionDesc\">Quale affermazione rispecchia meglio l’attuale approccio alla Process Automation nella sua azie...</span> <span class=\"LeftOpDesc\">L’automazione è integrata trasversalmente nella strategia aziendale, coinvolgendo più dipartimenti e processi.</span> <span class=\"OpDesc\">è selezionato</span> ","Conjuction":"Or"},"3":{"LogicType":"Question","QuestionID":"QID11","QuestionIsInLoop":"no","ChoiceLocator":"q://QID11/SelectableChoice/5","Operator":"Selected","QuestionIDFromLocator":"QID11","LeftOperand":"q://QID11/SelectableChoice/5","Type":"Expression","Description":"<span cla