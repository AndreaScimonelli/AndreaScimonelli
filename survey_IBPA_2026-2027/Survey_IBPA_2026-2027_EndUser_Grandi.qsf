{"SurveyEntry":{"SurveyID":"SV_5WBPCuZOo6EI1sN","SurveyName":"Survey IBPA 2026 - End User Grandi imprese","SurveyDescription":null,"SurveyOwnerID":"UR_cSGyJAp59NL7cF0","SurveyBrandID":"polimi","DivisionID":null,"SurveyLanguage":"IT","SurveyActiveResponseSet":"RS_S81ff5j7rcsZ8QD","SurveyStatus":"Inactive","SurveyStartDate":"0000-00-00 00:00:00","SurveyExpirationDate":"0000-00-00 00:00:00","SurveyCreationDate":"2026-11-05 12:00:00","CreatorID":"UR_cSGyJAp59NL7cF0","LastModified":"2026-11-05 12:00:00","LastAccessed":"0000-00-00 00:00:00","LastActivated":"0000-00-00 00:00:00","Deleted":null},"SurveyElements":[{"SurveyID":"SV_5WBPCuZOo6EI1sN","Element":"BL","PrimaryAttribute":"Survey Blocks","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":[{"Type":"Default","Description":"Introduzione","ID":"BL_m7zpma5OMVIIsZM","BlockElements":[{"Type":"Question","QuestionID":"QID1"}],"Options":{"BlockLocking":"false","RandomizeQuestions":"false","BlockVisibility":"Expanded"}},{"Type":"Trash","Description":"Domande eliminate nel cestino / inutilizzate","ID":"BL_hi0JQkiU9M6POsl","BlockElements":[]},{"Type":"Standard","SubType":"","Description":"Questionario","ID":"BL_ru8qkQQuEZJ35lT","BlockElements":[{"Type":"Question","QuestionID":"QID2"},{"Type":"Question","QuestionID":"QID3","SkipLogic":[{"SkipLogicID":1,"ChoiceLocator":"q://QID3/SelectableChoice/17","Condition":"Selected","SkipToDestination":"QID53","Locator":"q://QID3/SelectableChoice/17","SkipToDescription":"Settore di attività: Selezi... <strong>Public Administration</strong>  <strong>è selezionato</strong>","Description":"Condizione: <strong title=\"Public Administration\">Public Administration</strong> <strong>è selezionato</strong>. Salta a: <strong>Questo sondaggio ha l’obiettivo di ma...</strong>.","QuestionID":"QID3"}]},{"Type":"Question","QuestionID":"QID4","SkipLogic":[{"SkipLogicID":2,"ChoiceLocator":"q://QID4/SelectableChoice/1","Condition":"Selected","SkipToDestination":"QID53","Locator":"q://QID4/Selectable