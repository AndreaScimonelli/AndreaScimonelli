:"Or"},"Type":"AndIf"},"Type":"BooleanExpression","inPage":false}}},{"SurveyID":"SV_5WBPCuZOo6EI1sN","Element":"SQ","PrimaryAttribute":"QID38","SecondaryAttribute":"Aspettative e risultati Le domande seguenti non chiedono quanto bene abbiano funzionato le iniz...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:29px;\"><strong>Aspettative e risultati</strong></span><br />\n<br />\n<em><span style=\"font-size:16px;\">Le domande seguenti non chiedono quanto bene abbiano funzionato le iniziative, ma quanto si siano discostate da ciò che l’azienda si attendeva prima di avviarle. Risponda sulla base delle iniziative effettivamente avviate, non di quelle soltanto valutate.</span></em>","DefaultChoices":false,"DataExportTag":"Q9","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Aspettative e risultati Le domande seguenti non chiedono quanto bene abbiano funzionato le iniz...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"NextChoiceId":4,"NextAnswerId":1,"GradingData":[],"Language":[],"QuestionID":"QID38","DisplayLogic":{"0":{"0":{"LogicType":"Question","QuestionID":"QID11","QuestionIsInLoop":"no","ChoiceLocator":"q://QID11/SelectableChoice/1","Operator":"Selected","QuestionIDFromLocator":"QID11","LeftOperand":"q://QID11/SelectableChoice/1","Type":"Expression","Description":"<span class=\"ConjDesc\">Se</span> <span class=\"QuestionDesc\">Quale affermazione rispecchia meglio l’attuale approccio alla Process Automation nella sua azie...</span> <span class=\"LeftOpDesc\">L’automazione è applicata a specifici dipartimenti o processi, senza una strategia aziendale centralizzata (es. automazione limitata a HR o gestione ordini).</span> <span class=\"OpDesc\">è selezionato</span> "},"1":{"LogicType":"Question","QuestionID":"QID11","QuestionIsInLoop":"no","ChoiceLocator":"q://QID11/SelectableChoice/2","Operator":"Selected","Qu